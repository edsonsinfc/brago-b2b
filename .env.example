# Configurações do Servidor
PORT=3100
NODE_ENV=production

# Banco de Dados MySQL (ALTERE COM AS CREDENCIAIS DA KINGHOST)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=seu_usuario_mysql
MYSQL_PASSWORD=sua_senha_mysql
MYSQL_DATABASE=nexus_b2b

# Oracle ERP (opcional)
ORACLE_USER=erp_user
ORACLE_PASS=secret
ORACLE_CONNECT=192.168.0.10:1521/ERP

# JWT Secret (MUDE PARA UMA CHAVE FORTE!)
JWT_SECRET=troque-por-uma-chave-muito-segura-de-no-minimo-32-caracteres

# CORS
CORS_ORIGIN=https://bragodistribuidora.com.br

# Email SMTP Zoho (CONFIGURE COM SUAS CREDENCIAIS)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@bragodistribuidora.com.br
SMTP_PASS=sua_senha_email

# URLs da Aplicação
BASE_URL=https://bragodistribuidora.com.br
FRONTEND_URL=https://bragodistribuidora.com.br

# Admin seed (opcional)
ADMIN_EMAIL=admin@bragodistribuidora.com.br
ADMIN_PASSWORD=123456
BCRYPT_ROUNDS=10
